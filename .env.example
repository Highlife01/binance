# ============================================================================
# BINANCE SANAL VE CANLI SPOT ALIM-SATIM SISTEMI - ORNEK AYAR DOSYASI (.env.example)
# ============================================================================
# KULLANIM:
# 1. kurulum.bat calistirildiginda bu dosya otomatik olarak ".env" adıyla kopyalanir.
# 2. Sistem VARSAYILAN olarak GUVENLI SANAL DENEME (ENABLE_LIVE_TRADING=false) modunda acilir.
# 3. Gercek parayla (Canli Spot) islem yapmak isterseniz:
#    - Once sanal modda sistemi ve maliyetleri gozlemleyin.
#    - Binance API Management panelinden YALNIZCA "Enable Reading" ve
#      "Enable Spot & Margin Trading" acik, "Enable Withdrawals (Cekim)" KESINLIKLE KAPALI
#      ve mumkunse IP kisitlamali bir anahtar uretin.
#    - Anahtarlarinizi sohbet ekranina YAZMAYIN; yalnizca bilgisayarinizdaki .env icine girin.
#    - ENABLE_LIVE_TRADING=true yapip arayuzdeki Canli Islem Onay Kilidini acin.
# ============================================================================

# --- Calisma Modu Kilidi (Varsayilan: false -> Sanal Deneme) ---
ENABLE_LIVE_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_LIVE_BASE_URL=https://api.binance.me
BINANCE_RECV_WINDOW_MS=5000

# --- Yapay Zeka (Istege Bagli) ---
# Anahtarinizi sohbet ekranina YAZMAYIN; yalnizca kendi bilgisayarinizdaki .env dosyasina girin.
GEMINI_API_KEY=

# Resmi google-genai SDK ile uyumlu varsayilan model kodu
# Dogrulanmis secenekler: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Yapay zeka cagri sinirlari (Maliyet ve hiz siniri korumasi)
AI_DAILY_CALL_LIMIT=25
AI_MIN_CALL_INTERVAL_SECONDS=180
AI_TIMEOUT_SECONDS=20

# Tahmini maliyet hesabi icin opsiyonel birim fiyat varsayimi (1 Milyon token basina USD)
# NOT: Google AI Studio ucretsiz katmanda 0 olabilir; ucretli katmanda modele gore degisir.
# Kesin fatura degildir, yalnizca kullanici varsayimina dayali tahmini gostergedir.
AI_ESTIMATED_INPUT_USD_PER_1M=0.10
AI_ESTIMATED_OUTPUT_USD_PER_1M=0.40
AI_PRICING_VERIFIED=false

# --- Sanal Portfoy ve Risk Varsayimlari (Yatirim tavsiyesi degildir) ---
INITIAL_BALANCE_USDC=86.00
MAX_OPEN_POSITIONS=1
MAX_POSITION_SIZE_USDC=10.00
DAILY_LOSS_LIMIT_USDC=2.00
MAX_DAILY_NEW_POSITIONS=3

# Gunluk zarar esigi asildiginda acik pozisyon cikis politikasi:
# HOLD_EXISTING = Yeni alimlari durdur, mevcut pozisyonu zarar-kes/hedef veya manuel kapatmaya birak
# AUTO_CLOSE    = Yeni alimlari durdur ve acik sanal pozisyonu o anki piyasa alici fiyatindan kapat
DAILY_LIMIT_EXIT_POLICY=HOLD_EXISTING

# --- Islem Maliyeti ve Dolum Varsayimlari ---
# Binance standart spot komisyon varsayimi (%0.10 = 0.0010). Panelden degistirilebilir.
ESTIMATED_FEE_RATE=0.0010
# Ekstra muhafazakar kayma (slippage) tamponu (baz puan: 2 bps = %0.02)
EXTRA_SLIPPAGE_BPS=2.0

# --- Piyasa Verisi ve Zaman Dilimi ---
# Turkiye'den dogrudan erisilebilen resmi dokumante Binance veri sunucusu (api.binance.me)
BINANCE_PUBLIC_BASE_URL=https://api.binance.me
BINANCE_FALLBACK_BASE_URL=https://data-api.binance.vision
DEFAULT_SYMBOL=BTCUSDC
DEFAULT_INTERVAL=15m
MAX_DATA_AGE_SECONDS=120
SYSTEM_TIMEZONE=Europe/Istanbul
SQLITE_DB_PATH=data/sanal_sistem.db
